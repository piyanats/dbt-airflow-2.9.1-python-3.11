# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/config/gcp-key.json

# dbt Configuration (Single Project)
DBT_DATASET=analytics
DBT_PROFILES_DIR=/opt/airflow/dbt_project
DBT_PROJECT_DIR=/opt/airflow/dbt_project

# dbt Configuration (Multiple Projects)
SALES_DATASET=sales_analytics
MARKETING_DATASET=marketing_analytics
FINANCE_DATASET=finance_analytics

# Service Account Keys for Each Project (optional - for separate permissions)
# If not set, will fall back to GOOGLE_APPLICATION_CREDENTIALS
# SALES_SERVICE_ACCOUNT_KEY=/opt/airflow/config/sales-sa-key.json
# MARKETING_SERVICE_ACCOUNT_KEY=/opt/airflow/config/marketing-sa-key.json
# FINANCE_SERVICE_ACCOUNT_KEY=/opt/airflow/config/finance-sa-key.json

# For GKE Workload Identity (optional)
# DBT_SERVICE_ACCOUNT=dbt-service-account@your-project.iam.gserviceaccount.com

# Service Account Emails for Workload Identity (per project)
# SALES_SERVICE_ACCOUNT_EMAIL=sales-dbt@your-project.iam.gserviceaccount.com
# MARKETING_SERVICE_ACCOUNT_EMAIL=marketing-dbt@your-project.iam.gserviceaccount.com
# FINANCE_SERVICE_ACCOUNT_EMAIL=finance-dbt@your-project.iam.gserviceaccount.com
